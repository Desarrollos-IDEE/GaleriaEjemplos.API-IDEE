pipeline {
    agent { 
      dockerfile {
			args '-u 1002:978 --privileged -v /var/run/docker.sock:/var/run/docker.sock  -v /home/isdefeG/.ssh:/home/jenkins/.ssh'
		  }
    }

    parameters {
        booleanParam(defaultValue: false,description: '¿Desea desplegar en DESARROLLO?', name: 'checkDesarrollo')
        booleanParam(defaultValue: true,description: '¿Desea desplegar en CERTIFICACIÓN?', name: 'checkCert')
		    booleanParam(defaultValue: false,description: '¿Desea desplegar en PRODUCCIÓN?', name: 'checkProd')
		    string(defaultValue:'aaaa/mm/dd', description:'Introducir versión de despliegue', name:'versionProyecto') 
        string(name: 'RAMA_DESPLIEGUE', defaultValue: 'GaleriaEjemplosAPICNIG', description: 'Rama desde la que se desplegará')
    }
    
    environment {
		    NAME_IMAGE = "vis_com-galeriaEjemplos"
        AWS_ACCESS_KEY_ID = credentials("AWS_ACCESS_KEY_ID")
    		AWS_SECRET_ACCESS_KEY = credentials("AWS_SECRET_ACCESS_KEY")
        DISTRIBUTION_ID = "E3R8RHTMUIVQU2"
        RUTA_TRABAJO_JENKINS = "/home/isdefeG/jenkins-agent/workspace/galeriaEjemplos"
    }
    
    stages {
        stage('Checkout desde GitHub') {
            steps {
                checkout([
                    $class: 'GitSCM', 
                    branches: [[name: '*/GaleriaEjemplosAPICNIG']],  
                    userRemoteConfigs: [[
                        url: 'https://github.com/VisualizadoresCartograficos/Despliegue_Visualizadores.git',
                        credentialsId: 'IDEESpain'
                    ]],
                    extensions: [
                        [$class: 'SubmoduleOption', recursiveSubmodules: true]
                    ]
                ])
            }
        }

        
        stage('1 cargar entornos') {
                when {
                    expression { return params.checkDesarrollo}
                }
                steps {
    
                    sh ("python3 -v 1_cargar_entornos.py")
                    
                }
        }

        stage('2 git clone') {
            when {
                expression { return params.checkDesarrollo}
            }
            steps {
                sh ("python3 -v 2_git_clone.py" -u $USER-IDEESpain -c $TOKEN-IDEESpain)
            }
        }

        stage('3 extraer copiar') {
            when {
                expression { return params.checkDesarrollo}
            }
            steps {

                sh ("python3 -v 3_extraer_copiar.py")
                
            }
        }

        stage('4 preparar conf') {
            when {
                expression { return params.checkDesarrollo}
            }
            steps {

                sh ("python3 -v 4_preparar_conf.py")
                
            }
        }

        stage('5 crear subir imagenes') {
            when {
                expression { return params.checkDesarrollo}
            }
            steps {

                sh ("python3 -v 5_crear_subir_imagenes.py -v ${params.versionProyecto} -e 1_desarrollo --no-localhost")
                sh ("python3 -v 5_crear_subir_imagenes.py -v ${params.versionProyecto} -e 2_certificacion --no-localhost")
                sh ("python3 -v 5_crear_subir_imagenes.py -v ${params.versionProyecto} -e 3_produccion --no-localhost")
            }
        }

        stage('Deploy Desarrollo') {
    			when {
    					expression {return params.checkDes}
    			}
    			steps{
    				 
    				 sh'''
    				 sshpass -p $DEVELOP_PASS ssh -o StrictHostKeyChecking=no root@10.67.33.46 "docker pull localhost:5000/${NAME_IMAGE}_des:latest && cd /docker/idee_visualizadores/vis_com-galeriaEjemplos/1_desarrollo/${NAME_IMAGE}"
    				 sshpass -p $DEVELOP_PASS scp   imagenes/${NAME_IMAGE}_des.yml  root@10.67.33.46:/docker/idee_visualizadores/vis_com-galeriaEjemplos/1_desarrollo/${NAME_IMAGE}/${NAME_IMAGE}.yml
    				 sshpass -p $DEVELOP_PASS ssh -o StrictHostKeyChecking=no root@10.67.33.46 "cd /docker/idee_visualizadores/vis_com-galeriaEjemplos/1_desarrollo/${NAME_IMAGE} && docker-compose -f ${NAME_IMAGE}.yml up -d"
    				 '''
    				
    			}
		    }

        stage('Deploy Certificacion') {
    			when {
    					expression {return params.checkCert }
    			}
    			steps{
    				echo "Desplegando en certificación...."
    				sh '''
    					ssh -o StrictHostKeyChecking=no isdefeG@192.168.193.46 "cd /docker/${NAME_IMAGE} && ls -l && docker pull 10.67.33.46:5000/${NAME_IMAGE}_cer:latest && docker images"
    					scp   imagenes/${NAME_IMAGE}_cer.yml  isdefeG@192.168.193.46:/docker/${NAME_IMAGE}/${NAME_IMAGE}.yml
    					ssh -o StrictHostKeyChecking=no isdefeG@192.168.193.46 "cd /docker/${NAME_IMAGE} && ls -l && cat ${NAME_IMAGE}.yml && docker stack deploy --compose-file ${NAME_IMAGE}.yml ${NAME_IMAGE}"
    				'''
    				emailext attachLog: true, 
    				body: '''Desplegado $PROJECT_NAME en CERTIFICACIÓN - Build # $BUILD_NUMBER - $BUILD_STATUS: Check console output at $BUILD_URL to view the results.''', 
    				recipientProviders: [buildUser()], 
    				subject: '$PROJECT_NAME - CERTIFICACIÓN - Build # $BUILD_NUMBER - $BUILD_STATUS', 
    				to: 'proyectos@cnig.es, G_servicio_cnig@syvalue.com, aurelio.aragon@cnig.es, eduardo.martin@cnig.es, laura.gm@cnig.es, yaiza.gomez@cnig.es'
    			}
		}

      stage('Deploy Produción') {
  			when {
  					expression {return params.checkProd }
  			}
  			steps{
  				echo "Desplegamdo en producción...."
  				sh '''
  					ssh -o StrictHostKeyChecking=no isdefeG@192.168.192.42 "cd /docker/${NAME_IMAGE} && ls -l && docker pull 10.67.33.46:5000/${NAME_IMAGE}_prod:latest && docker images"
  					scp   imagenes/${NAME_IMAGE}_prod.yml  isdefeG@192.168.192.42:/docker/${NAME_IMAGE}/${NAME_IMAGE}.yml
  					ssh -o StrictHostKeyChecking=no isdefeG@192.168.192.42 "cd /docker/${NAME_IMAGE} && ls -l && cat ${NAME_IMAGE}.yml && docker stack deploy --compose-file ${NAME_IMAGE}.yml ${NAME_IMAGE}"
  					
  				'''
  				emailext attachLog: true, 
  				body: '''Desplegado $PROJECT_NAME en PRODUCCIÓN - Build # $BUILD_NUMBER - $BUILD_STATUS: Check console output at $BUILD_URL to view the results.''', 
  				recipientProviders: [buildUser()], 
  				subject: '$PROJECT_NAME - PRODUCCIÓN - Build # $BUILD_NUMBER - $BUILD_STATUS', 
  				to: 'proyectos@cnig.es, G_servicio_cnig@syvalue.com, aurelio.aragon@cnig.es, eduardo.martin@cnig.es, laura.gm@cnig.es, yaiza.gomez@cnig.es'
  			}
			}

      stage('Invalidate CloudFront Cache') {
            		steps {
                		script {
		                    sh '''
		                    aws configure set aws_access_key_id $AWS_ACCESS_KEY_ID
		                    aws configure set aws_secret_access_key $AWS_SECRET_ACCESS_KEY
		                    aws cloudfront create-invalidation --distribution-id $DISTRIBUTION_ID --paths "/GaleriaEjemplos*"
		                    '''
               			}
            		}
       	 	}

      stage('Limpiamos entorno de trabajo') {
  			steps{
  				sh "ls -l"
  				sh "docker system prune -af"
  			}
		  }
    }
}
